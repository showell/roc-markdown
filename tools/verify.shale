-- **EVERY CHECK OF roc-markdown, IN ONE RUN**: the
-- proof a change is sound, and the box's whole check of one. From the
-- repository's root:
--
--   shale tools/verify.shale
--
-- It prints one line a check, `PASS` or `FAIL` with its numbers, then
-- `verify: N of N passed` or `verify: FAILED`, and exits 0 only on the
-- first. **IT NEVER TOUCHES THE TREE**: roc-chat is checked out under
-- .zig-cache/verify/, beside a copy of package/.
--
-- The checks:
--   - first, the disk: under Shale's cookbook/disk.shale floor of free
--     space (20 GB) the run stops at once, with its line;
--   - Shale's Roc recipes over package/, each count held at the number in
--     LINTS, so a moved count fails the run;
--   - `zig build test`: the package's expects, the judge, and the REPL
--     piped against the frozen answers (judge/repl_check.zig), the
--     playground's wasm in node against them too and its page on a stand-in
--     DOM (playground/check.zig), the judge's own tests; the judge's count
--     a corpus must be exactly what ratchet.txt says: a different number is a
--     FAIL, never a pass;
--   - the paren and table shapes linear in their work units, and a ragged
--     table's quadratic padding refused by the budget;
--   - the strikethrough, backslash and image shapes linear too;
--   - `zig fmt --check` and `roc fmt --check` clean;
--   - roc-chat's `roc test` against this package (roc-chat's `chat=`
--     branch, default main, cloned beside a copy of package/);
--   - gold (`gold=`, default repos:gopher-gold/gold.jsonl, the box's),
--     judged in `zig build test`'s one judge run (`-Dalso`): every
--     one of its 10,103 cases agrees. **ONLY COUNTS ARE PRINTED, NEVER A
--     MESSAGE'S TEXT.** Where it is absent, `SKIP gold`, the one SKIP there
--     is;
--   - the judge's CPU time, and gold's part of it.
--
-- budget: steps=200000000 arena_bytes=1000000000 changes=10000 change_bytes=200000000 read_bytes=1000000000

-- Each corpus's case count, exactly: the ratchet's (judge/data/ratchet.txt),
-- their one home, where each may only rise.
local want = {}
local want_order = {}
local want_total = 0
for line in split(read("judge/data/ratchet.txt"), "\n") do
  if line ~= "" and not starts_with(line, "#") then
    local sp = find(line, " ")
    local label = sub(line, 1, sp - 1)
    want[label] = parse_int(sub(line, sp + 1))
    want_order[#want_order + 1] = label
    want_total = want_total + want[label]
  end
end
const gold_cases = 10103
const scratch_dir = ".zig-cache/verify"
-- `zig build test`: one judge run on the dev backend, gold included, about
-- 75 s of CPU (the hostile shapes nearly all of it), and a build first.
const judge_ms = 900000

-- The checklist so far: each line, and how many failed.
const board = {lines = {}, failed = 0}

function say(ok, what)
  local mark = "FAIL"
  if ok then mark = "PASS" end
  if not ok then board.failed = board.failed + 1 end
  board.lines[#board.lines + 1] = mark .. "  " .. what
  print(mark .. "  " .. what)
end

-- ── the disk, first ──
-- **A FULL DISK FAILS HERE, NEVER MID-RUN**: Shale's cookbook/disk.shale
-- stops under its floor of free space, its line naming the biggest growth
-- spots, and this run stops with that line.
local disk = run({"shale", real("cookbook:disk.shale")}, {cwd = ".", timeout_ms = 600000, tail = 5, width = 1000})
local disk_line = re_find(disk.out, "disk: [^\n]*")
if disk.code ~= 0 then
  local why = trim(disk.out)
  if disk_line ~= nil then why = disk_line.text end
  local steps = re_find(why, " \\(\\d+ steps\\)$")
  if steps ~= nil then why = sub(why, 1, #why - #steps.text) end
  fail("verify: " .. why)
end
say(disk_line ~= nil, disk_line ~= nil and disk_line.text or ("cookbook:disk.shale gave no line: " .. trim(disk.out)))

-- ── Shale's Roc recipes, the cheapest check ──
-- The recipes Safari's gate holds, over package/, every count held at zero but
-- `wide string`, which isn't held: an expect's frozen HTML is one string, and
-- Roc has no short way to split one.
const LINTS = {
  {recipe = "name_hunt", args = {}, budget = {}, counts = {
    {"state_effect", 0}, {"question", 0}, {"vague", 0}, {"name_type", 0}, {"negative", 0},
    {"noun_effect", 0}, {"command_tense", 0}, {"mixed_tense", 0}, {"container", 0},
    {"preposition_split", 0}, {"short_name", 0}, {"worker_name", 0}, {"stacked_preposition", 0},
    {"taken_word", 0}, {"bare_participle", 0},
  }},
  {recipe = "errors", args = {}, budget = {}, counts = {
    {"error_alias", 0}, {"optional_tag", 0}, {"set_fallback", 0}, {"placeholder", 0}, {"number_fallback", 0},
  }},
  {recipe = "nest_depth", args = {"min=4"}, budget = {}, counts = {{"nested", 0}}},
  {recipe = "parens", args = {}, budget = {}, counts = {{"paren_if", 0}, {"wrapped_body", 0}, {"else_block", 0}, {"lambda_if", 0}}},
  {recipe = "boundaries", args = {}, budget = {}, counts = {
    {"single", 0}, {"fixed", 0}, {"entry", 0}, {"constant", 0}, {"bool_param", 0}, {"dead", 0}, {"unused_api", 0}, {"same_branches", 0},
  }},
  {recipe = "stack", args = {}, budget = {"--budget", "steps=4000000000"}, counts = {{"to stack", 0}, {"to unstack", 0}, {"long", 0}}},
  {recipe = "vocabulary", args = {"words=tools/vocabulary.txt"}, budget = {}, counts = {{"retired_name", 0}, {"retired_comment", 0}}},
  {recipe = "plain_names", args = {}, budget = {}, counts = {{"pure_mutator", 0}, {"abbreviation", 0}, {"module_doc", 0}}},
  {recipe = "families", args = {}, budget = {}, counts = {{"family", 0}, {"twin_name", 0}}},
}

-- A recipe's last line that isn't blank or Shale's own footer: its counts.
function lint_summary(out)
  local summary = ""
  for l in lines(trim(out)) do
    if not starts_with(l, "──") and trim(l) ~= "" then summary = l end
  end
  return summary
end

-- The number a summary gives for `check`: "check N", or "N check" for stack's.
function count_in(line, check)
  local after = re_find(line, check .. " ([0-9]+)")
  if after ~= nil then return tonumber(after.group) end
  local before = re_find(line, "([0-9]+) " .. check)
  if before ~= nil then return tonumber(before.group) end
  return nil
end

-- The command that runs `lint` over package/.
function lint_argv(lint)
  local argv = {"shale"}
  for b in lint.budget do argv[#argv + 1] = b end
  argv[#argv + 1] = real("cookbook:roc/" .. lint.recipe .. ".shale")
  argv[#argv + 1] = "glob=package/*.roc"
  for a in lint.args do argv[#argv + 1] = a end
  return argv
end

for lint in LINTS do
  -- `want`: a gate recipe exits nonzero on a finding, and its counts say which.
  local r = run(lint_argv(lint), {cwd = ".", timeout_ms = 120000, whole = 4000000, want = "any"})
  local summary = lint_summary(r.out)
  local wrong = {}
  local said = {}
  for c in lint.counts do
    local got = count_in(summary, c[1])
    if got ~= c[2] then wrong[#wrong + 1] = c[1] .. " is " .. tostring(got) .. ", held at " .. c[2] end
    if got ~= 0 then said[#said + 1] = c[1] .. " " .. tostring(got) end
  end
  if contains(r.out, "refused: ") then wrong[#wrong + 1] = "a file was refused: " .. trim(r.out) end
  local held = #said == 0 and "all at zero" or join(said, ", ")
  say(#wrong == 0, "roc recipe " .. lint.recipe .. ": " .. (#wrong == 0 and held or join(wrong, "; ")))
end

-- The judge's `== <label>: P/T hold ...` lines, as {label = {pass, total}}.
function counts(out)
  local got = {}
  for line in split(out, "\n") do
    local m = re_find(line, "^== (\\w+): (\\d+)/(\\d+) hold")
    if m ~= nil then
      local label = sub(line, 4, find(line, ":") - 1)
      local nums = re_find(line, "(\\d+)/(\\d+)")
      local slash = find(nums.text, "/")
      got[label] = {pass = parse_int(sub(nums.text, 1, slash - 1)), total = parse_int(sub(nums.text, slash + 1))}
    end
  end
  return got
end

-- The judge's CPU time on a line of its own (`... in N ms CPU`), or -1.
function cpu_ms(line)
  if line == nil then return -1 end
  local m = re_find(line.text, " in (\\d+) ms CPU")
  if m == nil then return -1 end
  return parse_int(m.group)
end

-- ── zig build test, gold judged in the same run, and the counts ──
-- Gold (`gold=`, the box's by default) goes to the test step's judge
-- (`-Dalso`), so one judge run covers every corpus.
local gold = arg("gold", "repos:gopher-gold/gold.jsonl")
local have_gold = exists(gold)
local test_argv = {"zig", "build", "test"}
if have_gold then test_argv[#test_argv + 1] = "-Dalso=" .. real(gold) end
local t = run(test_argv, {cwd = ".", timeout_ms = judge_ms, tail = 60})
say(t.code == 0, "zig build test (exit " .. t.code .. ", " .. t.ms .. " ms)")
local got = counts(t.out)
local total = 0
for label in want_order do
  local g = get(got, label, nil)
  local n = 0
  local p = -1
  if g ~= nil then
    n = g.total
    p = g.pass
  end
  total = total + n
  say(n == want[label] and p == n, "cases: " .. label .. " " .. p .. "/" .. n .. " (want " .. want[label] .. ")")
end
say(total == want_total, "cases in all: " .. total .. " (want " .. want_total .. ")")
-- The REPL, piped, against the frozen answers (judge/repl_check.zig).
local rl = re_find(t.out, "== repl: [^\n]*")
say(rl ~= nil and re_find(rl.text, " 0 fail$") ~= nil, "the REPL: " .. (rl ~= nil and sub(rl.text, 9) or "no `== repl` line"))
-- The playground's wasm in node against the frozen answers, and its page
-- (playground/check.zig).
local pl = re_find(t.out, "== playground: [^\n]*")
say(pl ~= nil and re_find(pl.text, " 0 fail;") ~= nil, "the playground: " .. (pl ~= nil and sub(pl.text, 15) or "no `== playground` line"))
local pg = re_find(t.out, "== page: [^\n]*")
say(pg ~= nil, "the playground's page: " .. (pg ~= nil and sub(pg.text, 10) or "no `== page` line"))
-- Gold: only its count line is read, never a case's id or a message's text.
local gold_ms = -1
if not have_gold then
  board.lines[#board.lines + 1] = "SKIP  gold: not on this machine"
  print("SKIP  gold: not on this machine")
else
  local gc = get(got, "gold", {pass = -1, total = -1})
  gold_ms = cpu_ms(re_find(t.out, "== gold: [^\n]*"))
  say(gc.pass == gold_cases and gc.total == gold_cases, "gold: " .. gc.pass .. "/" .. gc.total .. " agree (want " .. gold_cases .. ")")
end
-- The judge's time, gold's part of it apart.
local judge_cpu = cpu_ms(re_find(t.out, "==> [^\n]*"))
say(judge_cpu >= 0, "the judge's time: " .. judge_cpu .. " ms CPU" .. (gold_ms >= 0 and (", gold " .. gold_ms .. " of it") or ""))

-- ── the paren and table shapes stay linear ──
-- Each shape's work units at 8,191 against its units at 1,000: linear is
-- 8.19 times, and past 9 times is a re-scan creeping in.
const linear_shapes = {"lb-nested-parens-in-dest", "rm-unbalanced-open-parens", "rm-unbalanced-close-parens", "rm-paren-bait", "rm-paren-links", "tbl-wide", "tbl-many-rows", "tbl-delimiter-alone", "tbl-code-pipes", "tbl-code-pipes-wide"}
-- The strikethrough and backslash shapes.
const linear_shapes_316 = {"rm-tilde-run", "rm-strike-nest", "rm-strike-unclosed", "rm-strike-mixed", "rm-strike-star-alternate", "rm-escaped-strikes", "rm-backslash-breaks", "lb-tilde-runs", "lb-mixed-delimiters-tilde"}
-- Markdown's image shapes.
const linear_shapes_317 = {"rm-image-openers", "rm-images", "rm-image-nest", "rm-image-alt-markup", "rm-images-refused", "rm-image-labels-alone", "lb-nested-images"}
function units_of(answers, id)
  local key = "{\"id\":\"" .. id .. "\""
  local at = find(answers, key)
  if at == nil then return -1 end
  local m = re_find(sub(answers, at, at + 400), "\"work_units\":(\\d+)")
  if m == nil then return -1 end
  return parse_int(m.group)
end
local hostile_answers = read("judge/data/hostile.answers.jsonl")
for shape in linear_shapes do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
for shape in linear_shapes_317 do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
for shape in linear_shapes_316 do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
-- A table 200 wide and 200 rows of one cell: 40,000 cells out of 1,206
-- bytes, padding its source never paid for, which the budget refuses.
local ragged_at = find(hostile_answers, "{\"id\":\"hostile/tbl-ragged/200\"")
local ragged = ragged_at ~= nil and re_find(sub(hostile_answers, ragged_at, ragged_at + 400), "\"hostile\":\"too much") ~= nil
say(ragged, "budget: hostile/tbl-ragged/200 (40,000 padded cells) is refused")

if exists(scratch_dir) then remove_tree(scratch_dir) end

-- ── the formatters ──
-- **THE PINNED ROC**: tools:roc-<pin>/roc, a tree's roc-version naming the
-- pin (pins live side by side; the PATH's may be another project's).
function pinned_roc(pin_file)
  local at = "tools:roc-" .. trim(read(pin_file)) .. "/roc"
  if not exists(at) then fail("verify: no " .. at .. " (the toolchain release carries it)") end
  return real(at)
end
local zf = run({"zig", "fmt", "--check", "build.zig", "judge", "playground"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(zf.code == 0, "zig fmt --check build.zig judge playground (" .. zf.ms .. " ms)" .. (zf.code == 0 and "" or (": " .. trim(zf.out))))
local rf = run({pinned_roc("roc-version"), "fmt", "--check", "package", "judge", "playground"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(rf.code == 0, "roc fmt --check package judge playground (" .. rf.ms .. " ms)")

-- ── roc-chat against this package ──
-- roc-chat's app names `../../roc-markdown/package/main.roc`: a copy of
-- package/ in .zig-cache/verify/roc-markdown, roc-chat's main beside it.
local beside = scratch_dir .. "/roc-markdown/package"
mkdir(beside)
for name in ls("package") do replace(beside .. "/" .. name, read("package/" .. name)) end
local chat_branch = arg("chat", "main")
local clone = run({"git", "clone", "-q", "--depth", "1", "--branch", chat_branch, "https://github.com/showell/roc-chat", real(scratch_dir) .. "/roc-chat"}, {cwd = ".", timeout_ms = 300000, tail = 10})
if clone.code ~= 0 then
  say(false, "roc-chat cloned (exit " .. clone.code .. ": " .. trim(clone.out) .. ")")
else
  local rt = run({pinned_roc(scratch_dir .. "/roc-chat/roc-version"), "test", "app/main.roc"}, {cwd = scratch_dir .. "/roc-chat", timeout_ms = 600000, tail = 5})
  say(rt.code == 0, "roc-chat's roc test against this package (exit " .. rt.code .. ", clone " .. clone.ms .. " ms, test " .. rt.ms .. " ms: " .. trim(rt.out) .. ")")
end


remove_tree(scratch_dir)
local checks = 0
for l in board.lines do
  if not starts_with(l, "SKIP") then checks = checks + 1 end
end
if board.failed == 0 then
  print("verify: " .. checks .. " of " .. checks .. " passed")
else
  print("verify: FAILED")
  fail(board.failed .. " of " .. checks .. " checks failed")
end
