-- **EVERY CHECK OF roc-markdown, IN ONE RUN**: the
-- proof a change is sound, and the box's whole check of one. From the
-- repository's root:
--
--   shale tools/verify.shale
--
-- It prints one line a check, `PASS` or `FAIL` with its numbers, then
-- `verify: N of N passed` or `verify: FAILED`, and exits 0 only on the
-- first. **IT NEVER TOUCHES THE TREE**: each planted fault is made in a
-- copy of judge/data under .zig-cache/verify/, which the judge is pointed
-- at with `--data`, and roc-chat is checked out there too.
--
-- The checks:
--   - `zig build test`: the package's expects, the judge, and the REPL
--     piped against the frozen answers (judge/repl_check.zig), the
--     playground's wasm in node against them too and its page on a stand-in
--     DOM (playground/check.zig); the judge's count
--     a corpus must be exactly what ratchet.txt says: a different number is a
--     FAIL, never a pass;
--   - the paren and table shapes linear in their work units, and a ragged
--     table's quadratic padding refused by the budget;
--   - five planted faults, each red: one byte of a frozen answer
--     (adversarial's, and a table's), one hostile hash, and a
--     spec_diverge.txt id that now matches (CommonMark's, and a table's);
--   - the strikethrough and backslash shapes linear, and three more plants,
--     each red: `~~` paired across a line, a backslash escape applied
--     inside a code span, one byte of a strikethrough;
--   - the image shapes linear, and three more plants, each red: an image
--     allowed from another origin, markup kept inside an alt, a
--     `javascript:` src rendered;
--   - plants, each red: a media src outside the host's uploads accepted,
--     a `'` left unescaped, one byte of a split function's answer, a
--     host's uploads rule ignored, a `..` path let through by the most
--     permissive rule;
--   - `zig fmt --check` and `roc fmt --check` clean;
--   - roc-chat's `roc test` against this package (roc-chat's `chat=`
--     branch, default main, cloned beside a copy of package/);
--   - gold (`gold=`, default repos:gopher-gold/gold.jsonl, the box's): every
--     one of its 10,103 cases agrees. **ONLY COUNTS ARE PRINTED, NEVER A
--     MESSAGE'S TEXT.** Where it is absent, `SKIP gold`, the one SKIP there
--     is;
--   - the judge's time, without gold and with it.
--
-- budget: steps=200000000 arena_bytes=1000000000 changes=10000 change_bytes=200000000 read_bytes=1000000000

-- Each corpus's case count, exactly: the ratchet's (judge/data/ratchet.txt),
-- their one home, where each may only rise.
local want = {}
local want_order = {}
local want_total = 0
for line in split(read("judge/data/ratchet.txt"), "\n") do
  if line ~= "" and not starts_with(line, "#") then
    local sp = find(line, " ")
    local label = sub(line, 1, sp - 1)
    want[label] = parse_int(sub(line, sp + 1))
    want_order[#want_order + 1] = label
    want_total = want_total + want[label]
  end
end
const gold_cases = 10103
const scratch_dir = ".zig-cache/verify"
const scratch_data = ".zig-cache/verify/data"
-- A judge run: about 40 s on the dev backend; a build first.
const judge_ms = 900000

-- The checklist so far: each line, and how many failed.
const board = {lines = {}, failed = 0}

function say(ok, what)
  local mark = "FAIL"
  if ok then mark = "PASS" end
  if not ok then board.failed = board.failed + 1 end
  board.lines[#board.lines + 1] = mark .. "  " .. what
  print(mark .. "  " .. what)
end

-- The judge's `== <label>: P/T hold ...` lines, as {label = {pass, total}}.
function counts(out)
  local got = {}
  for line in split(out, "\n") do
    local m = re_find(line, "^== (\\w+): (\\d+)/(\\d+) hold")
    if m ~= nil then
      local label = sub(line, 4, find(line, ":") - 1)
      local nums = re_find(line, "(\\d+)/(\\d+)")
      local slash = find(nums.text, "/")
      got[label] = {pass = parse_int(sub(nums.text, 1, slash - 1)), total = parse_int(sub(nums.text, slash + 1))}
    end
  end
  return got
end

function judge(args, keep)
  local argv = {"zig", "build", "judge", "--"}
  for a in args do argv[#argv + 1] = a end
  local opts = {cwd = ".", timeout_ms = judge_ms, tail = 60}
  if keep ~= nil then opts.re = keep end
  return run(argv, opts)
end

-- ── zig build test, and the counts ──
local t = run({"zig", "build", "test"}, {cwd = ".", timeout_ms = judge_ms, tail = 60})
say(t.code == 0, "zig build test (exit " .. t.code .. ", " .. t.ms .. " ms)")
local got = counts(t.out)
local total = 0
for label in want_order do
  local g = get(got, label, nil)
  local n = 0
  local p = -1
  if g ~= nil then
    n = g.total
    p = g.pass
  end
  total = total + n
  say(n == want[label] and p == n, "cases: " .. label .. " " .. p .. "/" .. n .. " (want " .. want[label] .. ")")
end
say(total == want_total, "cases in all: " .. total .. " (want " .. want_total .. ")")
-- The REPL, piped, against the frozen answers (judge/repl_check.zig).
local rl = re_find(t.out, "== repl: [^\n]*")
say(rl ~= nil and re_find(rl.text, " 0 fail$") ~= nil, "the REPL: " .. (rl ~= nil and sub(rl.text, 9) or "no `== repl` line"))
-- The playground's wasm in node against the frozen answers, and its page
-- (playground/check.zig).
local pl = re_find(t.out, "== playground: [^\n]*")
say(pl ~= nil and re_find(pl.text, " 0 fail;") ~= nil, "the playground: " .. (pl ~= nil and sub(pl.text, 15) or "no `== playground` line"))
local pg = re_find(t.out, "== page: [^\n]*")
say(pg ~= nil, "the playground's page: " .. (pg ~= nil and sub(pg.text, 10) or "no `== page` line"))

-- ── the paren and table shapes stay linear ──
-- Each shape's work units at 8,191 against its units at 1,000: linear is
-- 8.19 times, and past 9 times is a re-scan creeping in.
const linear_shapes = {"lb-nested-parens-in-dest", "rm-unbalanced-open-parens", "rm-unbalanced-close-parens", "rm-paren-bait", "rm-paren-links", "tbl-wide", "tbl-many-rows", "tbl-delimiter-alone", "tbl-code-pipes", "tbl-code-pipes-wide"}
-- The strikethrough and backslash shapes.
const linear_shapes_316 = {"rm-tilde-run", "rm-strike-nest", "rm-strike-unclosed", "rm-strike-mixed", "rm-strike-star-alternate", "rm-escaped-strikes", "rm-backslash-breaks", "lb-tilde-runs", "lb-mixed-delimiters-tilde"}
-- Markdown's image shapes.
const linear_shapes_317 = {"rm-image-openers", "rm-images", "rm-image-nest", "rm-image-alt-markup", "rm-images-refused", "rm-image-labels-alone", "lb-nested-images"}
function units_of(answers, id)
  local key = "{\"id\":\"" .. id .. "\""
  local at = find(answers, key)
  if at == nil then return -1 end
  local m = re_find(sub(answers, at, at + 400), "\"work_units\":(\\d+)")
  if m == nil then return -1 end
  return parse_int(m.group)
end
local hostile_answers = read("judge/data/hostile.answers.jsonl")
for shape in linear_shapes do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
for shape in linear_shapes_317 do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
for shape in linear_shapes_316 do
  local small = units_of(hostile_answers, "hostile/" .. shape .. "/1000")
  local big = units_of(hostile_answers, "hostile/" .. shape .. "/8191")
  say(small > 0 and big > 0 and big * 10 <= small * 90, "linear: " .. shape .. " " .. small .. " units at 1,000, " .. big .. " at 8,191")
end
-- A table 200 wide and 200 rows of one cell: 40,000 cells out of 1,206
-- bytes, padding its source never paid for, which the budget refuses.
local ragged_at = find(hostile_answers, "{\"id\":\"hostile/tbl-ragged/200\"")
local ragged = ragged_at ~= nil and re_find(sub(hostile_answers, ragged_at, ragged_at + 400), "\"hostile\":\"too much") ~= nil
say(ragged, "budget: hostile/tbl-ragged/200 (40,000 padded cells) is refused")

-- ── the planted faults, each in a copy of judge/data ──
if exists(scratch_dir) then remove_tree(scratch_dir) end
mkdir(scratch_data)
for name in ls("judge/data") do
  replace(scratch_data .. "/" .. name, read("judge/data/" .. name))
end

-- One byte of a frozen answer: the first `tag` (`<p>`, `<td>`) of the
-- answers, its `<` and the letter after it made `<q`.
function one_byte(s, tag)
  local at = find(s, tag)
  if at == nil then return s end
  return sub(s, 1, at) .. "q" .. sub(s, at + 2)
end

-- One hostile hash: the first `html_hash`'s first hex digit, another.
function one_hash(s)
  local key = "\"html_hash\":\""
  local at = find(s, key)
  if at == nil then return s end
  local d = at + #key
  local other = "0"
  if sub(s, d, d) == "0" then other = "1" end
  return sub(s, 1, d - 1) .. other .. sub(s, d + 1)
end

-- A spec_diverge.txt id that matches the spec: the first case of `corpus`
-- (spec_agree, spec_tables) the list does not name.
function stale_diverge(s, corpus)
  local listed = {}
  for line in split(s, "\n") do
    if line ~= "" and not starts_with(line, "#") then
      local tab = find(line, "\t")
      if tab == nil then tab = #line + 1 end
      listed[sub(line, 1, tab - 1)] = true
    end
  end
  for line in split(read("judge/data/" .. corpus .. ".jsonl"), "\n") do
    if line ~= "" then
      local c = json_read(line)
      if get(listed, c.id, nil) == nil then return s .. c.id .. "\tplanted\ta case that matches\n" end
    end
  end
  return s
end

-- `with.old`'s first place in `s` made `with.new`: an answer frozen wrong
-- in one known way.
function swap(s, with)
  local at = find(s, with.old)
  if at == nil then return s end
  return sub(s, 1, at - 1) .. with.new .. sub(s, at + #with.old)
end

-- Plants `kind` (with `with`, its tag or its corpus) into the copy's
-- `file`, runs the judge on the copy, requires red, and the judge's own
-- line for that fault (`mark`, so a red for any other reason is no pass),
-- and puts the file back.
function plant(what, file, kind, with, mark)
  local p = scratch_data .. "/" .. file
  local was = read(p)
  local now = was
  if kind == "one_byte" then now = one_byte(was, with) end
  if kind == "one_hash" then now = one_hash(was) end
  if kind == "stale_diverge" then now = stale_diverge(was, with) end
  if kind == "swap" then now = swap(was, with) end
  if now == was then
    say(false, "plant: " .. what .. ": the plant changed nothing")
    return nil
  end
  replace(p, now)
  local r = judge({"--data", real(scratch_data)}, "^(==|SPEC|FAILID)")
  replace(p, was)
  local named = 0
  for line in split(r.out, "\n") do
    if starts_with(line, mark) then named = named + 1 end
  end
  say(r.code ~= 0 and named == 1, "plant: " .. what .. " is red (exit " .. r.code .. "; " .. named .. " `" .. trim(mark) .. "` line, want 1)")
end

plant("one byte of a frozen answer (adversarial)", "adversarial.answers.jsonl", "one_byte", "<p>", "FAILID\tadversarial\t")
plant("one byte of a frozen table (spec_tables)", "spec_tables.answers.jsonl", "one_byte", "<td>", "FAILID\tspec_tables\t")
plant("one wrong hostile hash", "hostile.answers.jsonl", "one_hash", nil, "FAILID\thostile\t")
plant("a spec_diverge id that now matches", "spec_diverge.txt", "stale_diverge", "spec_agree", "SPECSTALE\t")
plant("a spec_diverge table id that now matches", "spec_diverge.txt", "stale_diverge", "spec_tables", "SPECSTALE\t")
-- `~~` paired across a line in the hard-wrap render; a
-- backslash escape applied inside a code span (CommonMark's cm/17); a
-- strikethrough answer's byte.
plant("`~~` paired across a line", "dialect.answers.jsonl", "swap", {old = "\"html\":\"<p>~~foo<br>\\nbar~~</p>", new = "\"html\":\"<p><del>foo<br>\\nbar</del></p>"}, "FAILID\tdialect\t")
plant("a backslash escape applied inside a code span", "spec_escapes.answers.jsonl", "swap", {old = "<code>\\\\[\\\\`</code>", new = "<code>[`</code>"}, "FAILID\tspec_escapes\t")
plant("one byte of a frozen strikethrough (spec_strike)", "spec_strike.answers.jsonl", "one_byte", "<del>", "FAILID\tspec_strike\t")
-- An image allowed from another origin; markup kept inside an
-- alt; a `javascript:` src rendered as an image.
plant("an image allowed from another origin", "dialect.answers.jsonl", "swap", {old = "<a href=\\\"https://elsewhere.example/a.png\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">off</a>", new = "<img src=\\\"https://elsewhere.example/a.png\\\" alt=\\\"off\\\">"}, "FAILID\tdialect\t")
plant("markup kept inside an alt", "dialect.answers.jsonl", "swap", {old = "alt=\\\"a b c d\\\"", new = "alt=\\\"a &lt;em&gt;b&lt;/em&gt; c d\\\""}, "FAILID\tdialect\t")
plant("a javascript: src rendered", "dialect.answers.jsonl", "swap", {old = "<a href=\\\"\\\">js</a>", new = "<img src=\\\"javascript:alert(1)\\\" alt=\\\"js\\\">"}, "FAILID\tdialect\t")
-- A media src outside the host's uploads accepted (an app
-- route, a held stream, rebuilt as an image).
plant("a media src outside the host's uploads accepted", "dialect.answers.jsonl", "swap", {old = "&lt;img src=&quot;/conversations/1/stream&quot;&gt;", new = "<img src=\\\"/conversations/1/stream\\\">"}, "FAILID\tdialect\t")
-- A `'` left unescaped (CommonMark's cm/12, its punctuation).
plant("a ' left unescaped", "spec_escapes.answers.jsonl", "swap", {old = "&#39;", new = "'"}, "FAILID\tspec_escapes\t")
-- One byte of the split dispatcher's answer: `blocks`' heading, which
-- Md.block_at's heading_onto writes.
plant("one byte of a split function's answer (a heading)", "examples.answers.jsonl", "one_byte", "<h1>", "FAILID\texamples\t")
-- A host's uploads rule ignored: a same-origin src roc-chat's rule refuses
-- (`/files/`), rendered as media without asking it.
plant("a host's uploads rule ignored (media rendered without asking it)", "dialect.answers.jsonl", "swap", {old = "&lt;img src=&quot;/files/b.png&quot;&gt;", new = "<img src=\\\"/files/b.png\\\">"}, "FAILID\tdialect\t")
-- A `..` path let through by a rule that takes every same-origin path: the
-- package's own URL checks come first, whatever the rule.
plant("a `..` path passed by a permissive rule", "same_origin.answers.jsonl", "swap", {old = "&lt;img src=&quot;/anything/../login&quot;&gt;", new = "<img src=\\\"/anything/../login\\\">"}, "FAILID\tsame_origin\t")

-- ── the formatters ──
local zf = run({"zig", "fmt", "--check", "build.zig", "judge", "playground"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(zf.code == 0, "zig fmt --check build.zig judge playground" .. (zf.code == 0 and "" or (": " .. trim(zf.out))))
local rf = run({"roc", "fmt", "--check", "package", "judge", "playground"}, {cwd = ".", timeout_ms = 60000, tail = 20})
say(rf.code == 0, "roc fmt --check package judge playground")

-- ── roc-chat against this package ──
-- roc-chat's app names `../../roc-markdown/package/main.roc`: a copy of
-- package/ in .zig-cache/verify/roc-markdown, roc-chat's main beside it.
local beside = scratch_dir .. "/roc-markdown/package"
mkdir(beside)
for name in ls("package") do replace(beside .. "/" .. name, read("package/" .. name)) end
local chat_branch = arg("chat", "main")
local clone = run({"git", "clone", "-q", "--depth", "1", "--branch", chat_branch, "https://github.com/showell/roc-chat", real(scratch_dir) .. "/roc-chat"}, {cwd = ".", timeout_ms = 300000, tail = 10})
if clone.code ~= 0 then
  say(false, "roc-chat cloned (exit " .. clone.code .. ": " .. trim(clone.out) .. ")")
else
  local rt = run({"roc", "test", "app/main.roc"}, {cwd = scratch_dir .. "/roc-chat", timeout_ms = 600000, tail = 5})
  say(rt.code == 0, "roc-chat's roc test against this package (exit " .. rt.code .. ": " .. trim(rt.out) .. ")")
end

-- ── the judge's time, and gold ──
local plain = judge({}, "^==>")
say(plain.code == 0, "the judge's time without gold: " .. plain.ms .. " ms")
local gold = arg("gold", "repos:gopher-gold/gold.jsonl")
if not exists(gold) then
  board.lines[#board.lines + 1] = "SKIP  gold: not on this machine"
  print("SKIP  gold: not on this machine")
else
  -- Only the summary lines are kept: no case's id, no message's text.
  local g = judge({"--also", real(gold)}, "^== gold:|^==>")
  local gc = get(counts(g.out), "gold", {pass = -1, total = -1})
  say(g.code == 0 and gc.pass == gold_cases and gc.total == gold_cases, "gold: " .. gc.pass .. "/" .. gc.total .. " agree (want " .. gold_cases .. "); the judge's time with gold: " .. g.ms .. " ms")
end

remove_tree(scratch_dir)
local checks = 0
for l in board.lines do
  if not starts_with(l, "SKIP") then checks = checks + 1 end
end
if board.failed == 0 then
  print("verify: " .. checks .. " of " .. checks .. " passed")
else
  print("verify: FAILED")
  fail(board.failed .. " of " .. checks .. " checks failed")
end
